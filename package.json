{
  "version": "0.0.0",
  "private": true,
  "description": "vulpine JavaScript Framework",
  "license": "MIT",
  "author": "Darius A. Bualan Jr.",
  "type": "commonjs",
  "main": "index.js",
  "workspaces": [
    "projects/*"
  ],
  "scripts": {
    "docs": "npm start --prefix projects/docs",
    "app": "npm start --prefix projects/test",
    "build": "npm run build -w vulpine && npm run build -w vulpine-dev",
    "publish-core:dev": "npm publish -w vulpine --userconfig .npmrc.dev",
    "publish-dev:dev": "npm publish -w vulpine-dev --userconfig .npmrc.dev",
    "lint-core": "npx eslint \"c:/Users/User/Desktop/final-framework/projects/core/src\" --no-error-on-unmatched-pattern || true"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.48.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "vulpine": "^0.0.21"
  }
}
