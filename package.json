{
  "version": "0.0.0",
  "private": true,
  "description": "vulpine JavaScript Framework",
  "license": "MIT",
  "author": "Darius A. Bualan Jr.",
  "type": "commonjs",
  "main": "index.js",
  "workspaces": [
    "projects/*"
  ],
  "scripts": {
    "docs": "npm start --prefix projects/docs",
    "app": "npm start --prefix projects/test",
    "build": "npm run build -w vulpine && npm run build -w vulpine-dev",
    "publish-core:dev": "npm publish -w vulpine --userconfig .npmrc.dev",
    "publish-dev:dev": "npm publish -w vulpine-dev --userconfig .npmrc.dev",
    "format": "prettier --write \"projects/**/src/**/*.ts\"",
    "lint": "eslint \"projects/**/src/**/*.{ts,tsx}\" --ext .ts,.tsx",
    "lint:fix": "eslint \"projects/**/src/**/*.{ts,tsx}\" --ext .ts,.tsx --fix",
    "prepare": "husky install"
  },
  "lint-staged": {
    "projects/**/src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ]
  },
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "typescript": "^5.9.3",
    "prettier": "^3.6.2",
  "eslint": "^8.48.0",
  "@typescript-eslint/parser": "^7.0.0",
  "@typescript-eslint/eslint-plugin": "^7.0.0",
  "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.0"
  }
}
